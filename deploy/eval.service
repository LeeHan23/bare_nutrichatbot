[Unit]
Description=Nutribot Judge Calibration (eval review tool)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=han
WorkingDirectory=/home/han/Desktop/projects/bare_NutriChatbot
EnvironmentFile=/home/han/Desktop/projects/bare_NutriChatbot/.env
ExecStart=/home/han/Desktop/projects/bare_NutriChatbot/.venv/bin/python -m uvicorn eval_api:app --host 0.0.0.0 --port 8200
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
