{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nutribot.computationalrd.com/schemas/mhc-eka-patient-feed.json",
  "title": "Nutribot EKA patient feed (My Heart Coach)",
  "description": "Response of GET /content/patient-feed?phone_number=... with X-API-Key: <MHC_API_KEY>. As of 2026-11-17.",
  "type": "object",
  "required": [
    "phone_number",
    "patient_name",
    "condition_groups",
    "personalization_level",
    "onboarding_stage",
    "week_number",
    "fallback_from_week",
    "is_active",
    "feed",
    "total"
  ],
  "properties": {
    "phone_number": {
      "type": "string",
      "description": "As normalised by Nutribot, e.g. +60173362070."
    },
    "patient_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "From MHC users."
    },
    "condition_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/condition_group"
      },
      "description": "MHC conditions mapped to Nutribot content groups."
    },
    "personalization_level": {
      "$ref": "#/$defs/level_or_null",
      "description": "After safety floors: HF, MI, stroke or CKD -> L3; hypertension or diabetes -> L2."
    },
    "onboarding_stage": {
      "$ref": "#/$defs/stage_or_null",
      "description": "Set while onboarding is unfinished, else null."
    },
    "week_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 53,
      "description": "ISO week actually served."
    },
    "fallback_from_week": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Set when the current week isn't approved yet and an older week was served instead."
    },
    "is_active": {
      "type": "boolean",
      "description": "Echo of the request filter."
    },
    "feed": {
      "type": "object",
      "required": [
        "E",
        "K",
        "A"
      ],
      "additionalProperties": false,
      "properties": {
        "E": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exercise_item"
          }
        },
        "K": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledge_item"
          }
        },
        "A": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activity_item"
          }
        }
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of items across E, K and A."
    }
  },
  "$defs": {
    "condition_group": {
      "type": "string",
      "enum": [
        "T2DM",
        "HTN",
        "CKD",
        "Cardiac",
        "PCOS",
        "Dyslipidaemia",
        "Heart Failure",
        "Atrial Fibrillation",
        "CVD Risk Management",
        "Mental Health",
        "Stress Management",
        "Sleep",
        "General"
      ]
    },
    "level_or_null": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        null
      ]
    },
    "stage_or_null": {
      "enum": [
        "OB1",
        "OB2",
        "OB3",
        null
      ]
    },
    "item_base": {
      "type": "object",
      "required": [
        "id",
        "content_type",
        "content_type_label",
        "condition_group",
        "condition_tags",
        "personalization_level",
        "onboarding_stage",
        "week_number",
        "day_offset",
        "topic",
        "title",
        "is_active",
        "content",
        "review_notes",
        "created_at",
        "expires_at",
        "is_expired"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Stable Nutribot id. Use it as the task id for completion tracking."
        },
        "content_type": {
          "enum": [
            "E",
            "K",
            "A"
          ]
        },
        "content_type_label": {
          "enum": [
            "Exercise",
            "Knowledge",
            "Activity"
          ]
        },
        "condition_group": {
          "$ref": "#/$defs/condition_group"
        },
        "condition_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "personalization_level": {
          "$ref": "#/$defs/level_or_null",
          "description": "Set XOR onboarding_stage."
        },
        "onboarding_stage": {
          "$ref": "#/$defs/stage_or_null"
        },
        "week_number": {
          "type": "integer"
        },
        "day_offset": {
          "type": "null",
          "description": "Always null for EKA."
        },
        "topic": {
          "type": "string",
          "description": "Machine slug."
        },
        "title": {
          "type": "string",
          "description": "Display title."
        },
        "is_active": {
          "type": "boolean",
          "description": "Approved by the dietitian team."
        },
        "content": {
          "type": "object"
        },
        "review_notes": {
          "type": "array",
          "description": "Internal reviewer comments. Not for display."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC, no offset."
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "UTC, no offset."
        },
        "is_expired": {
          "type": "boolean",
          "description": "The fallback week can be past expiry and is still served. Don't filter on it."
        }
      }
    },
    "exercise_item": {
      "allOf": [
        {
          "$ref": "#/$defs/item_base"
        }
      ],
      "properties": {
        "content_type": {
          "const": "E"
        },
        "content": {
          "type": "object",
          "required": [
            "framing",
            "catalog_highlights",
            "general_safety_note",
            "malaysian_context"
          ],
          "properties": {
            "framing": {
              "type": "string",
              "description": "1-2 sentences on this week's focus."
            },
            "catalog_highlights": {
              "type": "array",
              "minItems": 1,
              "description": "Catalog exercises allowed for the item's level. Items generated with none are filled with 2 at serve time.",
              "items": {
                "type": "object",
                "required": [
                  "title",
                  "why_it_helps",
                  "type",
                  "intensity_tier",
                  "body_focus",
                  "video_duration",
                  "video_url",
                  "explanation"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "Exact title from the approved Exercise Video catalog."
                  },
                  "why_it_helps": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "One sentence. Malay when auto_filled is true."
                  },
                  "type": {
                    "type": "string",
                    "examples": [
                      "Warm Up/Aerobic",
                      "Cardio/Aerobic",
                      "Strength/Resistance",
                      "Cooling Down/Stretching",
                      "Cooling Down"
                    ]
                  },
                  "intensity_tier": {
                    "type": "string",
                    "examples": [
                      "Light",
                      "Moderate",
                      "Vigorous"
                    ]
                  },
                  "body_focus": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "video_duration": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "m:ss"
                  },
                  "video_url": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uri",
                    "description": "YouTube link from the catalog; null only if the exercise was unapproved in the catalog."
                  },
                  "auto_filled": {
                    "type": "boolean",
                    "description": "Present and true when the API filled this exercise from the catalog."
                  },
                  "explanation": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "How the exercise is done, from the approved catalog (Malay). Matches the video at video_url."
                  }
                }
              }
            },
            "general_safety_note": {
              "type": "string",
              "description": "Stop conditions and care-team check."
            },
            "malaysian_context": {
              "type": "string"
            }
          }
        }
      }
    },
    "knowledge_item": {
      "allOf": [
        {
          "$ref": "#/$defs/item_base"
        }
      ],
      "properties": {
        "content_type": {
          "const": "K"
        },
        "content": {
          "type": "object",
          "required": [
            "topic_summary",
            "learning_points",
            "key_takeaway",
            "local_context"
          ],
          "properties": {
            "topic_summary": {
              "type": "string"
            },
            "learning_points": {
              "type": "array",
              "description": "6 items in current content.",
              "items": {
                "type": "object",
                "required": [
                  "point",
                  "explanation",
                  "why_it_matters"
                ],
                "properties": {
                  "point": {
                    "type": "string"
                  },
                  "explanation": {
                    "type": "string"
                  },
                  "why_it_matters": {
                    "type": "string"
                  }
                }
              }
            },
            "key_takeaway": {
              "type": "string"
            },
            "local_context": {
              "type": "string"
            }
          }
        }
      }
    },
    "activity_item": {
      "allOf": [
        {
          "$ref": "#/$defs/item_base"
        }
      ],
      "properties": {
        "content_type": {
          "const": "A"
        },
        "content": {
          "type": "object",
          "required": [
            "task_name",
            "description",
            "instructions",
            "tracking_method",
            "weekly_goal",
            "micro_actions",
            "self_monitoring_prompts",
            "success_looks_like"
          ],
          "properties": {
            "task_name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "instructions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "3-4 steps."
            },
            "tracking_method": {
              "type": "string"
            },
            "weekly_goal": {
              "type": "string"
            },
            "micro_actions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "6 entries: Monday to Friday, then Weekend."
            },
            "self_monitoring_prompts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "success_looks_like": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}