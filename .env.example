# ──────────────────────────────────────────────
# API KEYS & MODELS
# ──────────────────────────────────────────────

# Your OpenAI API key (required — used for LLM responses only)
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# LLM model for chatbot responses
# Options: "gpt-4-turbo", "gpt-4o", "gpt-3.5-turbo"
OPENAI_MODEL="gpt-4-turbo"

# Local embedding model (downloaded from HuggingFace on first run, ~130 MB)
# Do NOT change unless you retrain embeddings — must match what's stored in pgvector
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

# ──────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────

# PostgreSQL connection string for the app database (users, api_clients, documents)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nutribot"

# PostgreSQL connection string for the pgvector store (embeddings)
# Defaults to DATABASE_URL if not set — use a separate URL in production if needed
PGVECTOR_URL="postgresql://postgres:postgres@localhost:5432/nutribot"

# ──────────────────────────────────────────────
# FILE PATHS
# ──────────────────────────────────────────────

# Root path for persistent data (uploaded docs, image cache, etc.)
PERSISTENT_DISK_PATH="./data"

# Path to source PDFs for the shared foundational knowledge base
# Used by build_base_db.py — does not need to be inside the project directory
BASE_DOCS_DIR="./data/base_docs"

# ──────────────────────────────────────────────
# AUTHENTICATION
# ──────────────────────────────────────────────

# Password for the /admin panel (plain text)
ADMIN_PASSWORD="changeme"

# ──────────────────────────────────────────────
# SERVER
# ──────────────────────────────────────────────

# Port FastAPI listens on (used by Dockerfile CMD and docker-compose)
PORT=8000

# ──────────────────────────────────────────────
# OPTIONAL SERVICES
# ──────────────────────────────────────────────

# Redis URL for session management (leave unset to use in-memory sessions)
# REDIS_URL="redis://localhost:6379"
